# Скопируйте в .env и замените значения. .env в git не попадает.
# Секреты генерируйте так:  openssl rand -hex 32

POSTGRES_USER=cdss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cdss

# Пароль роли cdss_app (без BYPASSRLS), под которой работает API. Задаётся при первой миграции.
APP_DB_PASSWORD=change-me-too

JWT_SECRET=
HMAC_KEY=

APP_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost
UI_PORT=80
# Прямой порт API (только localhost): метрики Prometheus, отладка
API_PORT=8000

# Первый super_admin создаётся при seed (оба поля обязательны для создания)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# 1 — создать демо-организацию "demo" с формуляром (для презентаций)
SEED_DEMO_ORG=0
